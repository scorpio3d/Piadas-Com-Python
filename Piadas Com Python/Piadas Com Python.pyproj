  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="main.py" />
    <Compile Include="modules\analise_dados.py" />
    <Compile Include="modules\ia_sarcastica.py" />
    <Compile Include="modules\motor_api.py" />
    <Compile Include="modules\personagem.py" />
